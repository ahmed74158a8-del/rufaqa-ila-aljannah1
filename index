 "ربنا تقبل منا إنك أنت السميع العليم."
 ];
 document.getElementById("dua").textContent=
 duas[Math.floor(Math.random()*duas.length)];
}
function exportData(){
 let blob=new Blob([JSON.stringify(data)],{type:"application/json"});
 let a=document.createElement("a");
 a.href=URL.createObjectURL(blob);
 a.download="rufaqa-progress.json";
 a.click();
 URL.revokeObjectURL(a.href);
}
function importData(e){
 let f=e.target.files[0];
 if(!f)return;
 let reader=new FileReader();
 reader.onload=()=>{
 try{
 let obj=JSON.parse(reader.result);
 if(!obj.ahmed||!obj.heba)throw Error();
 data=obj;save();alert("تم استيراد التقدم بنجاح");
 }catch(err){alert("الملف غير صالح");}
 };
 reader.readAsText(f);
}
document.getElementById("person").addEventListener("change",render);
render();
</script>
