[11/10/2026 10:18 PM] Ahm: const storageKey="rufaqa_app_data";
let data=JSON.parse(localStorage.getItem(storageKey)||'{"ahmed":{},"heba":{}}');
let current="ahmed";

function dateKey(){
 return new Date().toLocaleDateString("en-CA");
}
function today(){
 return data[current][dateKey()]||[];
}
function save(){
 localStorage.setItem(storageKey,JSON.stringify(data));
 render();
}
function toggleTask(i,checked){
 let arr=today().filter(x=>x!==i);
 if(checked)arr.push(i);
 data[current][dateKey()]=arr;
 save();
}
function render(){
 current=document.getElementById("person").value;
 let done=today();
 document.getElementById("tasks").innerHTML=habits.map((h,i)=>
 <div class="task">
 <input type="checkbox" id="task${i}" ${done.includes(i)?"checked":""}
 onchange="toggleTask(${i},this.checked)">
 <label for="task${i}">${h}</label>
 </div>).join("");

 let percent=Math.round(done.length/habits.length*100);
 document.getElementById("done").textContent=done.length;
 document.getElementById("percent").textContent=percent+"%";
 document.getElementById("points").textContent=done.length*10;
 document.getElementById("bar").style.width=percent+"%";
 document.getElementById("message").textContent=
 percent===100?"ما شاء الله! أتممت تحدي اليوم 🌟":"كل خطوة خير تقربك من الله.";

 document.getElementById("ahmed").textContent=score("ahmed")+"%";
 document.getElementById("heba").textContent=score("heba")+"%";
}
function score(p){
 let arr=data[p][dateKey()]||[];
 return Math.round(arr.length/habits.length*100);
}
function changeDua(){
 let duas=[
 "اللهم أعنّا على ذكرك وشكرك وحسن عبادتك.",
 "ربنا هب لنا من أزواجنا وذرياتنا قرة أعين.",
